# Example environment variables.
# Copy to .env and adjust for your local setup.

# --- Backend (FastAPI) ---
# Comma-separated list of allowed CORS origins
# Tambahkan origin LAN bila ingin akses dari HP, misal: http://10.70.193.117:3000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL connection (asyncpg + SQLModel)
DATABASE_URL=postgresql+asyncpg://leaflens:leaflens@localhost:5432/leaflens

# Local storage directory for leaf images (relative to apps/api)
STORAGE_DIR=uploads

# Groq API (free, replaces Ollama)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_REASONING_MODEL=deepseek-r1-distill-llama-70b

# --- Frontend (Next.js) ---
# Untuk akses dari HP, ganti dengan IP LAN PC: http://<IP-LAN>:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
