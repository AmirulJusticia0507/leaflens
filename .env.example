# Example environment variables.
# Copy to .env and adjust for your local setup.

# --- Backend (FastAPI) ---
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# PostgreSQL connection (asyncpg + SQLModel)
DATABASE_URL=postgresql+asyncpg://leaflens:leaflens@localhost:5432/leaflens

# Local storage directory for leaf images (relative to apps/api)
STORAGE_DIR=uploads

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llama3.2-vision
OLLAMA_REASONING_MODEL=deepseek-r1

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
